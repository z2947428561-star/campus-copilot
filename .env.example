# Camps Copilot 环境变量模板
# 复制本文件为 .env 并填入真实密钥:.env 已被 .gitignore 忽略,永不进 git 仓库
#
# === DeepSeek(第 2 项,M0 必需)===
# 1. 注册/登录:https://platform.deepseek.com
# 2. 左侧菜单「API keys」->「创建 API key」-> 复制(只显示一次,立刻保存)
# 3. 充值:左侧「充值」,小额即可(以页面实际最低额度为准)
DEEPSEEK_API_KEY=sk-在这里粘贴你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# === LangSmith(M0 后期接入,M3 前不需要)===
# 注册:https://smith.lang.com,创建 API key 后填入,暂时留空即可
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
