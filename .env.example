# Campus Copilot 环境变量模板
# 用法:复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略,永不进仓库。
#
# 课程对应:第02章 §1.2(p2) 参数写在配置文件里(推荐),不硬编码
#          第03章 §2.3(p6) LangSmith 的四个变量
#          第10章 §2.4.2(p48-49) Embedding 走云端 OpenAI 兼容网关

# ============================================================ 对话模型(第02章)
# 注册/取 key:https://platform.deepseek.com → 「API keys」→ 创建
DEEPSEEK_API_KEY=sk-在这里粘贴你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型与推理参数(第02章 §3.3 p15-16)
#   temperature:课件建议 0.0-0.3 用于数学计算 / 数据提取 / 分类 / 代码生成;
#                本项目是"抽取事实 + 算 GPA + 路由工具",故取 0.2 而非课件默认 0.7
LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=6
# 摘要等辅助任务用的模型(第09章 §2.4.3 p34:可用便宜模型,但提醒成本会翻倍)
LLM_CHEAP_MODEL=deepseek-chat

# ============================================================ LangSmith(第03章 §2.3 p6)
# 课件列的是**四个**变量。注册:https://smith.langchain.com
# 注意:API key 只在创建时显示一次,务必立刻保存
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=campus-copilot

# 正式发布时填已解析到服务器的域名，然后运行 docker compose --profile production up -d --build
# CAMPUS_DOMAIN=chat.example.com
# Docker PostgreSQL 密码：至少 20 位随机字母数字串（不要包含 URL 特殊字符）
POSTGRES_PASSWORD=
# 单个用户名连续登录失败的窗口与阈值（进程内限流；正式公网仍建议边缘层限流）
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# ============================================================ Embedding(第10章 §2.4.2 p48-49)
# 课件用云端 OpenAI 兼容网关(CloseAI 的 text-embedding-3-large,
# 或硅基流动的 bge-m3 / Pro_BAAI/bge-m3)。**第10章全程未使用 Ollama。**
#   硅基流动 https://cloud.siliconflow.cn  → EMBED_MODEL=BAAI/bge-m3
#   阿里云百炼                              → EMBED_MODEL=text-embedding-v3(EMBED_DIM 仍设 1024)
# ⚠️ 换 embedding 模型 = 换向量空间,必须重建知识库(scripts/build_kb.py)
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# ============================================================ 向量库(第10章 §2.5.3 p52-54)
# 课件用 Milvus。Milvus 需要 Docker / WSL2;
# 尚未拉起 Milvus 时可临时设为 chroma,沿用旧的本地 Chroma 库过渡 ——
# 建库脚本与检索层共用这一处开关,不会各切一半。
KB_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=campus_copilot
MILVUS_COLLECTION=xmum_policies
MILVUS_METRIC_TYPE=COSINE
KB_TOP_K=5

# ============================================================ 记忆后端(第09章 §2.2 p14-18)
# sqlite 仅用于本地快速验证;部署用 postgres
MEMORY_BACKEND=sqlite
# postgres 示例:
# DATABASE_URL=postgresql://campus:campus_pw@127.0.0.1:5432/campus
DATABASE_URL=

# ============================================================ 本地 Ollama(第02章 §4.4 p24-25)
# 仅本地开发 / 降级验证用;云服务器上不要把降级备胎指向开发机
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# ============================================================ Agent 运行参数
# 第07章 §4.4 问题6(p26):默认没有工具调用次数限制,需显式设置
RECURSION_LIMIT=100
# 第08章 §3.1 p34 / §3.2 p44 的调用上限
TOOL_CALL_THREAD_LIMIT=200
MODEL_CALL_THREAD_LIMIT=200
# 摘要阈值(第08章 §2.1 p7-11):条数 + token 双阈值
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_TRIGGER_TOKENS=24000
SUMMARY_KEEP_MESSAGES=10
